# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 절대 커밋하지 않는다.

# --- 필수 ---------------------------------------------------------------
# 실명-가명 매핑 암호화 키. 운영에서는 KMS/Vault로 관리한다(제21.2장).
LV_PSEUDONYM_SECRET=반드시-교체할-임의의-긴-문자열
POSTGRES_PASSWORD=반드시-교체할-DB-비밀번호

# --- 공식 Source (없으면 해당 항목은 UNVERIFIED로 표시된다) ----------------
# 국가법령정보 공동활용 https://open.law.go.kr/
LV_LAW_GO_KR_OC=
# KCI Open API https://www.kci.go.kr/
LV_KCI_KEY=
# Crossref 예의상 연락처 (요청 우선순위에 영향)
LV_CROSSREF_MAILTO=

# --- LLM Provider (없으면 Level 4·5 의미검증은 수행되지 않는다) ------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- 정책 ---------------------------------------------------------------
LV_DEFAULT_AI_POLICY=LOCAL_ONLY    # ORIGINAL | MASKED | LOCAL_ONLY
LV_DEFAULT_PROFILE=STANDARD        # QUICK | STANDARD | DEEP_VERIFY
LV_MONTHLY_BUDGET_USD=0            # 0이면 상한 없음
LV_RUN_BUDGET_USD=0                # 0이면 실행별 상한 없음; 재시도도 원 실행 한도를 공유
LV_ALLOW_SEALED_REVEAL=1           # 0이면 봉인 원문 열람 전면 차단

# --- OCR ----------------------------------------------------------------
LV_OCR_LANG=kor+eng
LV_OCR_DPI=200
LV_OCR_PSM=6
LV_OCR_MIN_CONFIDENCE=0.55
LV_INDEPENDENT_OCR=auto            # auto | always | off (제7.3장 독립 OCR 교차검증)
LV_INDEPENDENT_OCR_PAGES=3

# --- 인프라 -------------------------------------------------------------
# LV_DATABASE_URL=postgresql+psycopg://legal:비밀번호@db:5432/legal_verifier
# LV_CELERY_BROKER=redis://redis:6379/0
LV_WORKER_MODE=auto                # auto | celery | inprocess
LV_ALLOW_NETWORK=1                 # 폐쇄망은 0
# 공식 출처 GET 재조회: 문서마다 기본 한도와 인용 수 기반 한도를 새로 부여한다.
LV_HTTP_TIMEOUT=12                 # 재시도 시 24/36초, 요청당 최대 45초
LV_SOURCE_LOOKUP_ATTEMPTS=3         # 일시적 장애만 재시도, 1~5회
LV_SOURCE_LOOKUP_BUDGET_SECONDS=120 # 문서별 기본 조회 시간(초)
LV_SOURCE_LOOKUP_MAX_DOCUMENT_SECONDS=900 # 인용 수에 따라 늘리는 문서별 상한
LV_SOURCE_LOOKUP_RECOVERY_SECONDS=120 # 지연 인용 재확인용 추가 한도, 문서당 1회

# --- v0.4 인증·작업 복구 -------------------------------------------------
LV_AUTH_MODE=local                 # 다중 사용자 운영은 multi-user + HTTPS + 계정 초기 설정
LV_SESSION_TTL_HOURS=24            # 브라우저 사용 중 자동 연장되는 미사용 제한(시간)
LV_SESSION_ABSOLUTE_HOURS=168      # 자동 연장해도 최초 로그인부터 최대 7일
# LV_ACCESS_TOKEN=                 # local 모드의 원격 단일 소유자 인증에만 사용
# LV_PUBLIC_ORIGIN=https://verifier.example.org
# LV_TRUSTED_PROXY_IPS=127.0.0.1    # 실제 신뢰하는 바로 앞 프록시만 지정
# LV_OIDC_ISSUER=
# LV_OIDC_AUDIENCE=
# LV_OIDC_JWKS_URL=
LV_JOB_MAX_ATTEMPTS=3
LV_JOB_LEASE_SECONDS=90
LV_JOB_POLL_SECONDS=2
LV_JOB_CONCURRENCY=2
# 가격 미등록 외부 모델은 기본 차단. 보수적인 호출 상한이 있을 때만 지정한다.
# LV_LLM_UNKNOWN_CALL_USD=
# 기본 로컬 키 파일은 자동 생성. OS 접근권한·키 백업은 운영자가 관리한다.
# LV_VAULT_KEY_PROVIDER=file       # file | env | aws-kms
# 자세한 설정: docs/IDENTITY_SECURITY_INTEGRATION.md, docs/OPERATIONS_DURABILITY.md
